---
import "../styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fffdf8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Typing Multiplayer" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>Something went wrong | Typing Multiplayer</title>
    <script is:inline>
      try {
        if (localStorage.getItem("type-and-tally-theme") === "dark") {
          document.documentElement.classList.add("dark");
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen">
    <main class="grid min-h-screen place-items-center px-5 py-12 text-center text-ink">
      <section class="max-w-xl">
        <p class="font-heading text-2xl text-red">500 / race paused</p>
        <h1 class="mt-3 font-heading text-6xl font-bold sm:text-8xl">A page hit a wrong key.</h1>
        <p class="mt-6 text-xl leading-relaxed text-ink-soft">Something went wrong while loading this page. Try the race again or check the typing FAQ for help.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a href="/" class="scribble-border bg-yellow px-5 py-3 font-heading text-xl font-bold paper-shadow-small">Back to race</a>
          <a href="/faq" class="scribble-border bg-card px-5 py-3 font-heading text-xl font-bold">Read the FAQ</a>
        </div>
      </section>
    </main>
  </body>
</html>
