---
import TypeAndTally from "../routes/index";
import "../styles.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#fffdf8" />
    <title>Typing Multiplayer  - Multiplayer Typing Races</title>
    <script is:inline>
      try {
        if (localStorage.getItem("type-and-tally-theme") === "dark") {
          document.documentElement.classList.add("dark");
        }
      } catch {}
    </script>
  </head>
  <body class="min-h-screen">
    <TypeAndTally client:load />
  </body>
</html>