---
import InfoPage from "../components/InfoPage.astro";
---

<InfoPage
  title="Contact Us"
  description="Contact the Typing Multiplayer team with questions, feedback, bug reports, or suggestions about the typing race."
>
  <p>Have a question about a race, found a bug, or have an idea that could make typing practice better? We would like to hear from you.</p>
  <div class="mt-8 scribble-border bg-card p-6 paper-shadow-small">
    <h2 class="font-heading text-3xl font-bold text-ink">Email the Typing Multiplayer team</h2>
    <p class="mt-3 text-lg">Send feedback, support requests, or partnership questions to:</p>
    <a class="mt-3 inline-block text-xl font-bold text-blue underline" href="mailto:irshadudheen.p10@gmail.com">irshadudheen.p10@gmail.com</a>
  </div>
  <h2 class="mt-10 font-heading text-3xl font-bold text-ink">What to include</h2>
  <p>For technical issues, tell us which page you were using, what happened, and the device or browser you used. Please do not include passwords, private keys, or other sensitive information.</p>
</InfoPage>
